{
  "manifest_version": 3,
  "name": "Bryan Pano Grabber (Live Edition)",
  "version": "3.1",
  "description": "Scanne et enregistre les ID et Coordonnees GPS en direct.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.google.com/maps/*",
    "*://*.google.fr/maps/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/maps/*",
        "*://*.google.fr/maps/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}