{
  "manifest_version": 3,
  "name": "Bryan Pano Grabber (Live Edition)",
  "version": "4.2",
  "description": "Scanne, enregistre et télécharge les panoramas en ZIP.",
  "permissions": [
    "storage",
    "clipboardWrite",
    "downloads"
  ],
  "host_permissions": [
    "*://*.google.fr/maps/*",
    "*://*.google.com/maps/*",
    "*://*.googleusercontent.com/*",
    "*://*.googleapis.com/*",
    "*://*.ggpht.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.fr/maps/*",
        "*://www.google.com/maps/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}