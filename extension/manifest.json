{
  "manifest_version": 3,
  "name": "Bryan Pano Grabber",
  "version": "2.2",
  "description": "Scanne, enregistre et convertit les ID Street View uniques.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.fr/*",
    "*://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.fr/maps/*",
        "*://www.google.com/maps/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}